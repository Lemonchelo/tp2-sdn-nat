{
  "_comment": "Fuente única de verdad para topo.py y el controlador. Para la demo: cambiar IPs/MACs acá (o en la sección topology) y NO tocar código.",

  "router": {
    "public":  { "ip": "200.0.0.254",   "mac": "00:00:00:aa:aa:aa", "subnet": "200.0.0.0/24",   "port": 1 },
    "private": { "ip": "192.168.1.254", "mac": "00:00:00:bb:bb:bb", "subnet": "192.168.1.0/24" }
  },

  "nat": {
    "port_range": [49152, 65535],
    "tcp_idle_timeout": 120,
    "udp_idle_timeout": 30,
    "icmp_idle_timeout": 10,
    "flow_priority": 100
  },

  "arp": {
    "ttl": 300,
    "request_timeout": 2.0,
    "max_retries": 3
  },

  "topology": {
    "_comment": "Sólo lo usa topo.py. El controlador NUNCA debe leer esta sección (no puede depender de IPs/MACs de los hosts).",
    "public_host":   { "name": "h1", "ip": "200.0.0.1/24",   "mac": "00:00:00:00:00:01" },
    "private_hosts": [
      { "name": "h2", "ip": "192.168.1.2/24", "mac": "00:00:00:00:00:02" },
      { "name": "h3", "ip": "192.168.1.3/24", "mac": "00:00:00:00:00:03" },
      { "name": "h4", "ip": "192.168.1.4/24", "mac": "00:00:00:00:00:04" }
    ]
  }
}
